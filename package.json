{
  "name": "dsh-plugin-demo",
  "version": "0.1.0",
  "description": "A minimal DeepSeek Harness (DSH) bundle template: one plugin row, no build step.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    ".gitattributes",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "plugin"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.5 <0.3.0"
  },
  "license": "MIT",
  "author": "20700499ww-byte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/20700499ww-byte/dsh-plugin-demo.git"
  },
  "homepage": "https://github.com/20700499ww-byte/dsh-plugin-demo#readme",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
